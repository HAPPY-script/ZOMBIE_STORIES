-- TWEEN MENU
--------------------------------------------------------
local openSize = UDim2.new(0.5, 0, 0.5, 0)
local closeSize = UDim2.new(0.025, 0, 0.025, 0)

local tweenInfo = TweenInfo.new(0.1, Enum.EasingStyle.Quad, Enum.EasingDirection.Out)

local menuOpen = false
local dragStartPos = nil
local dragging = false
local clickThreshold = 8

local function openMenu()
	main.Visible = true
	main.Size = closeSize
	TweenService:Create(main, tweenInfo, {Size = openSize}):Play()
end

local function closeMenu()
	local tween = TweenService:Create(main, tweenInfo, {Size = closeSize})
	tween:Play()
	tween.Completed:Once(function()
		if not menuOpen then
			main.Visible = false
		end
	end)
end

toggleButton.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		dragStartPos = input.Position
		dragging = false
	end
end)

toggleButton.InputChanged:Connect(function(input)
	if dragStartPos and (
		input.UserInputType == Enum.UserInputType.MouseMovement
			or input.UserInputType == Enum.UserInputType.Touch
		) then
		local delta = (input.Position - dragStartPos).Magnitude
		if delta > clickThreshold then dragging = true end
	end
end)

toggleButton.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1
		or input.UserInputType == Enum.UserInputType.Touch then
		if not dragging then
			menuOpen = not menuOpen
			if menuOpen then openMenu() else closeMenu() end
		end
		dragStartPos = nil
	end
end)

