local OFF_COLOR = Color3.fromRGB(255, 50, 50)
local ON_COLOR = Color3.fromRGB(50, 255, 50)

local function SetButtonState(btn, state)
	if state then
		btn.BackgroundColor3 = ON_COLOR
		btn.Text = "ON"
	else
		btn.BackgroundColor3 = OFF_COLOR
		btn.Text = "OFF"
	end
end

