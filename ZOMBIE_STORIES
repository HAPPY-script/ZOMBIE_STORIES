-- AIMBOT + KEY SELECT
--------------------------------------------------------
local aimbotEnabled = false
local keyHeld = false

local holdKey = Enum.KeyCode.F
keyButton.Text = "F"  -- mặc định

local selectingKey = false

-- Bật / tắt Aimbot
SetButtonState(btnAimbot, false)
btnAimbot.MouseButton1Click:Connect(function()
	aimbotEnabled = not aimbotEnabled
	SetButtonState(btnAimbot, aimbotEnabled)
end)

-- Bấm vào nút đổi key
keyButton.MouseButton1Click:Connect(function()
	if selectingKey then
		selectingKey = false
		keyButton.Text = holdKey.Name
	else
		selectingKey = true
		keyButton.Text = "..."
	end
end)

-- Nhận phím
UserInputService.InputBegan:Connect(function(input)
	if selectingKey then
		-- Nhận chuột
		if input.UserInputType == Enum.UserInputType.MouseButton1 then
			holdKey = Enum.UserInputType.MouseButton1
			keyButton.Text = "LMB"
			selectingKey = false
			return
		end
		if input.UserInputType == Enum.UserInputType.MouseButton2 then
			holdKey = Enum.UserInputType.MouseButton2
			keyButton.Text = "RMB"
			selectingKey = false
			return
		end

		-- Nhận phím bàn phím
		if input.KeyCode ~= Enum.KeyCode.Unknown then
			holdKey = input.KeyCode
			keyButton.Text = input.KeyCode.Name
			selectingKey = false
		end

		return
	end

	-- Giữ phím để aimbot hoạt động
	if input.KeyCode == holdKey or input.UserInputType == holdKey then
		keyHeld = true
	end
end)

UserInputService.InputEnded:Connect(function(input)
	if input.KeyCode == holdKey or input.UserInputType == holdKey then
		keyHeld = false
	end
end)

local function getClosestZombie()
	local best, bestDist = nil, math.huge
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

	for _, z in pairs(workspace:WaitForChild("Zombies"):GetChildren()) do
		local head = z:FindFirstChild("Head")
		if head then
			local p, vis = Camera:WorldToViewportPoint(head.Position)
			if vis then
				local dist = (Vector2.new(p.X, p.Y) - center).Magnitude
				if dist < bestDist and dist <= 200 then
					bestDist = dist
					best = head
				end
			end
		end
	end

	return best
end

RunService.RenderStepped:Connect(function()
	if aimbotEnabled and keyHeld then
		local head = getClosestZombie()
		if head then
			Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
		end
	end
end)

