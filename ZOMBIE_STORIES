local gradient = main:WaitForChild("UIGradient")
local fixedColor = Color3.fromRGB(200, 0, 255)

local pastelColors = {
	Color3.fromRGB(255, 150, 150),
	Color3.fromRGB(255, 200, 150),
	Color3.fromRGB(255, 255, 150),
	Color3.fromRGB(150, 255, 150),
	Color3.fromRGB(150, 200, 255),
	Color3.fromRGB(200, 150, 255),
	Color3.fromRGB(255, 150, 220)
}

task.spawn(function()
	local index = 1
	while true do
		local fromColor = pastelColors[index]
		local nextIndex = index + 1
		if nextIndex > #pastelColors then nextIndex = 1 end
		local toColor = pastelColors[nextIndex]

		local duration = 0.6
		local step = 0.03
		local elapsed = 0

		while elapsed < duration do
			local t = elapsed / duration
			local c = fromColor:Lerp(toColor, t)
			gradient.Color = ColorSequence.new({
				ColorSequenceKeypoint.new(0, c),
				ColorSequenceKeypoint.new(1, fixedColor)
			})
			task.wait(step)
			elapsed += step
		end

		gradient.Color = ColorSequence.new({
			ColorSequenceKeypoint.new(0, toColor),
			ColorSequenceKeypoint.new(1, fixedColor)
		})

		index = nextIndex
	end
end)

