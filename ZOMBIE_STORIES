-- Lấy zombie tốt nhất (ưu tiên gần world distance, tiebreak bằng screen distance)
local function getBestZombie()
	local zombiesFolder = workspace:FindFirstChild("Zombies")
	if not zombiesFolder then return nil end

	local camPos = Camera.CFrame.Position
	local center = Vector2.new(Camera.ViewportSize.X/2, Camera.ViewportSize.Y/2)

	local bestModel = nil
	local bestScore = math.huge

	for _, z in ipairs(zombiesFolder:GetChildren()) do
		if z:IsA("Model") then
			local head = z:FindFirstChild("Head")
			if head then
				local worldDist = (head.Position - camPos).Magnitude
				if worldDist <= 1000 then
					local vp = Camera:WorldToViewportPoint(head.Position)
					if vp.Z > 0 then
						local screenDist = (Vector2.new(vp.X, vp.Y) - center).Magnitude
						local score = worldDist + screenDist * 0.25
						if score < bestScore then
							bestScore = score
							bestModel = z
						end
					end
				end
			end
		end
	end

	return bestModel
end

-- Aimbot hoạt động (aim vào head của model)
RunService.RenderStepped:Connect(function()
	if aimbotEnabled and keyHeld then
		local zombie = getBestZombie()
		if zombie then
			local head = zombie:FindFirstChild("Head")
			if head then
				Camera.CFrame = CFrame.new(Camera.CFrame.Position, head.Position)
			end
		end
	end
end)

